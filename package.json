{
  "name": "@mieweb/docidx",
  "version": "2.0.0",
  "description": "Markdown content index compiler producing SQLite hybrid index artifacts (sqlite-vec + FTS5) for RAG agents",
  "type": "module",
  "engines": {
    "node": ">= 20.10.0"
  },
  "bin": {
    "docidx": "./bin/docidx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsx src/cli/main.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "docidx": "tsx src/cli/main.ts",
    "mcp": "tsx src/cli/mcp.ts"
  },
  "keywords": [
    "documentation",
    "search",
    "embeddings",
    "sqlite",
    "fts5",
    "vector-search",
    "rag",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/docidx.git"
  },
  "author": "MIE",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pdf-parse": "^1.1.5",
    "better-sqlite3": "^11.6.0",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.12.0",
    "mdast-util-to-string": "^4.0.0",
    "minimist": "^1.2.8",
    "openai": "^4.73.0",
    "pdf-parse": "^2.4.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sqlite-vec": "^0.1.6",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "winston": "^3.17.0",
    "xxhash-wasm": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
